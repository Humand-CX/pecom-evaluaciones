# Get these from your Humand admin
HUMAND_CLIENT_ID=your-client-id
HUMAND_CLIENT_SECRET=your-client-secret
HUMAND_API_URL=https://api-prod.humand.co
POSTGREST_BASE_URL=https://views-cx.humand.co

# M2M client (client_credentials grant, audience=views-cx) — separate from the USER client above
HUMAND_M2M_CLIENT_ID=your-m2m-client-id
HUMAND_M2M_CLIENT_SECRET=your-m2m-client-secret
GITHUB_TOKEN=github-token
JANUS_URL=https://api-prod.humand.co/api/v1/janus
APP_CALLBACK_URL=https://<your-vercel-url>/api/auth/callback
VITE_HUMAND_APP_URL=https://app.humand.co
