{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_SUPABASE_URL": "@VITE_SUPABASE_URL",
    "VITE_SUPABASE_ANON_KEY": "@VITE_SUPABASE_ANON_KEY",
    "VITE_HUMAND_API_URL": "@VITE_HUMAND_API_URL",
    "VITE_HUMAND_CLIENT_ID": "@VITE_HUMAND_CLIENT_ID",
    "VITE_HUMAND_INSTANCE_ID": "@VITE_HUMAND_INSTANCE_ID",
    "VITE_HUMAND_CALLBACK_URL": "@VITE_HUMAND_CALLBACK_URL"
  }
}
